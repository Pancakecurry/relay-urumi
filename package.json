{
  "name": "relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages tests",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "env:inspect": "node scripts/environment.mjs",
    "cluster:setup": "bash scripts/cluster-setup.sh",
    "cluster:status": "bash scripts/cluster-status.sh",
    "proof:deploy": "bash scripts/proof-deploy.sh",
    "proof:client": "node dist/packages/mcp-client/src/probe.js",
    "store:deploy": "bash scripts/store-deploy.sh",
    "store:checkout": "node tests/store/checkout.mjs",
    "store:persistence": "node scripts/store-persistence.mjs",
    "store:status": "node scripts/store-status.mjs",
    "mcp:deploy": "bash scripts/mcp-deploy.sh",
    "mcp:acceptance": "node scripts/mcp-acceptance.mjs",
    "mcp:network": "node scripts/mcp-network.mjs",
    "platform:deploy": "bash scripts/platform-deploy.sh",
    "platform:acceptance": "node scripts/platform-acceptance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/inspector": "2.10.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.15.6",
    "better-auth": "1.7.7",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/fastify": "2.0.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
